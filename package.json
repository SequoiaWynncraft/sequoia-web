{
  "name": "sequoia-web",
  "version": "2.0.0",
  "description": "Sequoia website monorepo.",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --dir frontend dev",
    "dev:web": "pnpm --dir frontend dev",
    "build": "pnpm build:web && pnpm build:backend",
    "build:web": "pnpm --dir frontend build",
    "build:backend": "cargo build --manifest-path backend/Cargo.toml --workspace --all-features",
    "preview:web": "pnpm --dir frontend preview",
    "start:web": "pnpm --dir frontend start",
    "check": "pnpm check:web && pnpm check:backend",
    "check:web": "pnpm --dir frontend check",
    "check:backend": "cargo check --manifest-path backend/Cargo.toml --workspace --all-targets --all-features",
    "clippy:backend": "cargo clippy --manifest-path backend/Cargo.toml --workspace --all-targets --all-features -- -D warnings",
    "fmt:backend": "cargo fmt --manifest-path backend/Cargo.toml --all --check",
    "test": "pnpm test:web && pnpm test:backend",
    "test:web": "pnpm --dir frontend test:unit",
    "test:backend": "cargo test --manifest-path backend/Cargo.toml --workspace --all-features",
    "api:types": "pnpm --dir frontend api:types"
  }
}
