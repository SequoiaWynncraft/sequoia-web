{
  "name": "sequoia-web",
  "version": "2.0.0",
  "description": "Sequoia website monorepo.",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "trustedDependencies": ["esbuild"],
  "overrides": {
    "cookie": "^0.7.2",
    "js-yaml": "^4.2.0"
  },
  "scripts": {
    "dev": "bun run --cwd frontend dev",
    "dev:web": "bun run --cwd frontend dev",
    "build": "bun run build:web && bun run build:backend",
    "build:web": "bun run --cwd frontend build",
    "build:backend": "cargo build --manifest-path backend/Cargo.toml --workspace --all-features",
    "preview:web": "bun run --cwd frontend preview",
    "start:web": "bun run --cwd frontend start",
    "check": "bun run check:lockfile && bun run check:web && bun run check:backend",
    "check:lockfile": "bun scripts/audit-lockfile.mjs",
    "check:web": "bun run --cwd frontend check",
    "check:backend": "cargo check --manifest-path backend/Cargo.toml --workspace --all-targets --all-features",
    "clippy:backend": "cargo clippy --manifest-path backend/Cargo.toml --workspace --all-targets --all-features -- -D warnings",
    "fmt:backend": "cargo fmt --manifest-path backend/Cargo.toml --all --check",
    "test": "bun run test:web && bun run test:backend",
    "test:web": "cd frontend && node --run test:unit --",
    "test:backend": "cargo test --manifest-path backend/Cargo.toml --workspace --all-features",
    "api:types": "bun run --cwd frontend api:types"
  }
}
