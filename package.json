{
  "name": "sequoia-web",
  "version": "2.0.0",
  "description": "Sequoia website monorepo.",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --dir frontend dev",
    "dev:web": "pnpm --dir frontend dev",
    "build": "pnpm --dir frontend build",
    "build:web": "pnpm --dir frontend build",
    "preview:web": "pnpm --dir frontend preview",
    "start:web": "pnpm --dir frontend start",
    "check": "pnpm --dir frontend check",
    "check:web": "pnpm --dir frontend check",
    "test": "pnpm --dir frontend test:unit",
    "test:web": "pnpm --dir frontend test:unit",
    "api:types": "pnpm --dir frontend api:types"
  }
}
