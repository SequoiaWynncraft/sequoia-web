{
  "name": "seqwebsite",
  "version": "2.0.0",
  "description": "Sequoia - Wynncraft guild website (statistics, community, legal).",
  "type": "module",
  "private": true,
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "bun ./build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "svelte-kit sync && vitest run",
    "api:types": "openapi-typescript ../../sequoia-backend/openapi/public.yaml -o src/lib/api/generated/public-api.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.0.0",
    "openapi-typescript": "^7.13.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.1.6",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "discord-markdown-parser": "1.3.1",
    "emoji-regex": "10.6.0",
    "emojibase-data": "17.0.0"
  }
}
