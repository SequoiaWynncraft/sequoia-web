{
  "name": "seqwebsite",
  "version": "2.0.0",
  "description": "Sequoia — Wynncraft guild website (statistics, community, legal).",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "svelte-kit sync && vitest run",
    "api:types": "openapi-typescript ../../sequoia-backend/src/main/resources/openapi/public.yaml -o src/lib/api/generated/public-api.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "2.67.0",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@types/node": "26.0.0",
    "openapi-typescript": "^7.13.0",
    "svelte": "5.56.4",
    "svelte-check": "4.7.1",
    "typescript": "5.9.3",
    "vite": "8.1.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4"
  }
}
