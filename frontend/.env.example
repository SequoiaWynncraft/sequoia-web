PUBLIC_SEQUOIA_API_BASE_URL=http://localhost:8081
PUBLIC_NMSR_BASE_URL=https://api.seqwawa.com/nmsr
SEQUOIA_WEB_BACKEND_URL=http://localhost:8080
# Same value as the Rust backend's INTERNAL_API_TOKEN; gates member-only tracker reads.
SEQUOIA_WEB_BACKEND_INTERNAL_TOKEN=

# Internal bag shop bot HTTP API. The SvelteKit server proxies to it and forwards the
# viewer's seq_session JWT as a bearer token. MUST stay internal (not publicly routed).
# Locally, run the bot with API_PORT set to something other than 8080 to avoid clashing
# with the Rust backend, e.g. API_PORT=8090.
BAGSHOP_API_URL=http://localhost:8090
# sequoia-backend's INTERNAL_API_TOKEN; gates mod-tracked event contribution reads.
SEQUOIA_BACKEND_INTERNAL_TOKEN=
# Server-side sequoia-backend origin for internal reads. Optional when the
# public base URL is absolute; required in same-origin mode.
# SEQUOIA_BACKEND_URL=https://api.seqwawa.com

# Optional Turso/libSQL cache for web-owned API routes.
# If unset, the app uses a local SQLite-compatible file at .data/sequoia-web.db.
SEQUOIA_WEB_DB_URL=file:.data/sequoia-web.db
# TURSO_DATABASE_URL=libsql://example.turso.io
# TURSO_AUTH_TOKEN=

# Use this when Coolify or another reverse proxy routes /public/** to sequoia-backend.
# PUBLIC_SEQUOIA_API_BASE_URL=same-origin
# PUBLIC_NMSR_BASE_URL=same-origin

# Theme for visitors who haven't picked one (see src/lib/site/themePreferences.ts).
# Unknown values fall back to gaz-purple. Baked in at build time.
PUBLIC_DEFAULT_THEME=gaz-purple
