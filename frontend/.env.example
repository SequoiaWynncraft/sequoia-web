PUBLIC_SEQUOIA_API_BASE_URL=http://localhost:8081
PUBLIC_NMSR_BASE_URL=https://api.seqwawa.com/nmsr
SEQUOIA_WEB_BACKEND_URL=http://localhost:8080
# Same value as the Rust backend's INTERNAL_API_TOKEN; gates member-only tracker reads.
SEQUOIA_WEB_BACKEND_INTERNAL_TOKEN=

# Optional Turso/libSQL cache for web-owned API routes.
# If unset, the app uses a local SQLite-compatible file at .data/sequoia-web.db.
SEQUOIA_WEB_DB_URL=file:.data/sequoia-web.db
# TURSO_DATABASE_URL=libsql://example.turso.io
# TURSO_AUTH_TOKEN=

# Use this when Coolify or another reverse proxy routes /public/** to sequoia-backend.
# PUBLIC_SEQUOIA_API_BASE_URL=same-origin
# PUBLIC_NMSR_BASE_URL=same-origin
